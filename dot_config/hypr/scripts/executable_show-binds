#!/usr/bin/env bash

hyprctl binds | awk '
    function flush() {
        if (key == "" || desc == "" || submap != "") { return }

        if (desc ~ /^Switch to workspace [0-9]+$/) {
            if (!ws_switch++) { printf "SUPER + 1-0\tSwitch to workspace 1-10\n" }
            return
        }
        if (desc ~ /^Move window and switch to workspace [0-9]+$/) {
            if (!ws_move++) { printf "SUPER + CTRL + 1-0\tMove window to workspace 1-10\n" }
            return
        }

        combo = ""
        if (int(modmask) % 128 >= 64) { combo = combo "SUPER + " }
        if (int(modmask) % 16  >= 8)  { combo = combo "ALT + " }
        if (int(modmask) % 8   >= 4)  { combo = combo "CTRL + " }
        if (int(modmask) % 2   >= 1)  { combo = combo "SHIFT + " }

        printf "%s%s\t%s\n", combo, toupper(key), desc
    }

    /^bind/ { flush(); modmask = ""; key = ""; desc = ""; submap = ""; next }

    /^[ \t]*modmask:/     { modmask = $2; next }
    /^[ \t]*key:/         { key = $2; next }
    /^[ \t]*submap:/      { sub(/^[ \t]*submap:[ \t]*/, ""); submap = $0; next }
    /^[ \t]*description:/ { sub(/^[ \t]*description:[ \t]*/, ""); desc = $0; next }

    END { flush() }
'
